<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% for (let i = 0; i < list.length; i++) { %>
        <ul>

            <br> Name: <%- list[i].name %>
            <br>Colors: <%- list[i].colors %>
            <br>Power: <%- list[i].power %>
            <br>Toughness: <%- list[i].toughness %>
            <br><img src="<%= list[i].image %>">
            
</ul>
<% } %>
</body>

</html>